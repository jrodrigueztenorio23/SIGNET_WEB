---
import { empresa, mensajes, wa } from '../config/site';

const anio = new Date().getFullYear();
const enlaces = [
  { href: '#inicio', texto: 'Inicio' },
  { href: '#modulos', texto: 'Módulos' },
  { href: '#clientes', texto: 'Clientes' },
  { href: '#plan', texto: 'Plan' },
  { href: '#nosotros', texto: 'Nosotros' },
  { href: '#cotizar', texto: 'Cotizar' },
];
---

<footer class="foot bg-navy text-paper" data-ink="#f8f8fb">
  <div class="foot-grid">
    <div class="ft ft-statement bg-navy-deep">
      <p class="text-[1.5rem] leading-tight font-semibold max-w-[24ch]">{empresa.producto}, el ERP web de {empresa.nombre}.</p>
      <p class="small opacity-80">© {anio} {empresa.nombre}. Todos los derechos reservados.</p>
    </div>
    <nav class="ft ft-nav bg-navy-deep" aria-label="Pie de página">
      <ul class="flex flex-col gap-1.5">
        {enlaces.map((e) => <li><a class="link-underline" href={e.href}>{e.texto}</a></li>)}
      </ul>
    </nav>
    <div class="ft ft-time bg-navy-deep">
      <p class="font-semibold">{empresa.ciudad}, Perú</p>
      <p class="title tabular" id="lima-time" aria-live="off">--:--</p>
      <p class="small opacity-80">{empresa.direccion}</p>
    </div>
    <div class="ft ft-contact bg-navy-deep">
      <p class="small opacity-80">WhatsApp y teléfono</p>
      <a class="text-[1.25rem] font-semibold link-underline" href={wa(mensajes.general)} target="_blank" rel="noopener">{empresa.whatsappVisible}</a>
      <a class="link-underline" href={`tel:${empresa.telefono.replace(/[^+\d]/g, '')}`}>{empresa.telefono}</a>
      {empresa.correo && <a class="link-underline" href={`mailto:${empresa.correo}`}>{empresa.correo}</a>}
    </div>
    <div class="ft ft-word bg-ink">
      <p class="wordmark" aria-hidden="true">SIG Advanced</p>
    </div>
    <a class="ft ft-go bg-orange text-ink" href={wa(mensajes.general)} target="_blank" rel="noopener">
      <span class="text-[1.75rem] font-bold leading-tight max-w-[12ch]">Escríbenos por WhatsApp</span>
      <svg class="go-arrow" width="64" height="64" viewBox="0 0 64 64" aria-hidden="true"><path d="M8 56 56 8M20 8h36v36" fill="none" stroke="currentColor" stroke-width="4"/></svg>
    </a>
  </div>
</footer>

<a class="wa-float" href={wa(mensajes.general)} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp">
  <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91A9.86 9.86 0 0 0 12.04 2Zm5.8 14.03c-.25.69-1.45 1.32-2 1.37-.51.05-.99.24-3.34-.7-2.82-1.11-4.6-3.99-4.74-4.18-.14-.18-1.13-1.5-1.13-2.87 0-1.36.71-2.03.97-2.31.25-.28.55-.35.73-.35l.53.01c.17.01.4-.06.62.48.25.6.84 2.07.92 2.22.07.14.12.31.02.5-.09.18-.14.3-.28.46-.14.16-.29.36-.42.48-.14.14-.28.29-.12.57.16.28.72 1.19 1.55 1.93 1.06.95 1.96 1.24 2.24 1.38.28.14.44.12.6-.07.17-.18.7-.81.88-1.09.19-.28.37-.23.62-.14.26.09 1.62.77 1.9.91.28.14.46.21.53.32.07.12.07.67-.18 1.36Z"/></svg>
</a>

<style>
  .foot { padding: 10px; }
  .foot-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 8px; }
  .ft { padding: 20px; display: flex; flex-direction: column; justify-content: space-between; gap: 1rem; min-height: 220px; }
  .ft-statement { grid-column: span 4; }
  .ft-nav { grid-column: span 3; justify-content: flex-start; }
  .ft-time { grid-column: span 2; }
  .ft-contact { grid-column: span 3; justify-content: flex-end; gap: 0.35rem; }
  .ft-word { grid-column: span 8; min-height: 320px; display: grid; place-items: center; overflow: hidden; }
  .ft-go { grid-column: span 4; min-height: 320px; transition: background-color 200ms ease; }
  .ft-go:hover { background: #ffb23a; }
  .go-arrow { align-self: flex-end; transition: transform 300ms var(--ease-out-quint); }
  .ft-go:hover .go-arrow { transform: translate(6px, -6px); }
  .wordmark {
    font-size: 7.2vw;
    font-weight: 860;
    font-stretch: 88%;
    letter-spacing: -0.04em;
    line-height: 1;
    white-space: nowrap;
    color: var(--color-paper);
  }

  .wa-float {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 60;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #1f9d55;
    color: #fff;
    box-shadow: 0 10px 30px -8px rgb(10 16 48 / 0.5); /* taste-skill-ignore: botón flotante */
    transition: transform 200ms var(--ease-out-quint), background-color 200ms ease;
  }
  .wa-float:hover { transform: scale(1.06); background: #188a49; }
  .wa-float:active { transform: scale(0.95); }

  @media (max-width: 1023px) {
    .foot-grid { grid-template-columns: 1fr 1fr; gap: 6px; }
    .ft { min-height: 0; }
    .ft-word { grid-column: span 2; order: -2; min-height: 160px; }
    .ft-go { grid-column: span 2; order: -1; min-height: 160px; }
    .ft-nav, .ft-contact, .ft-time, .ft-statement { grid-column: span 1; }
    .wordmark { font-size: 13vw; }
  }
  @media (max-width: 479px) {
    .ft-nav, .ft-contact, .ft-time, .ft-statement { grid-column: span 2; }
  }
</style>

<script>
  const el = document.getElementById('lima-time');
  if (el) {
    const fmt = new Intl.DateTimeFormat('es-PE', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: 'America/Lima' });
    const tick = () => (el.textContent = fmt.format(new Date()));
    tick();
    setInterval(tick, 15000);
  }
</script>
