---
import { empresa, mensajes, wa } from '../config/site';
import { tono, type Tono } from '../config/modelos';

interface Props { tone: Tono }
const { tone } = Astro.props;

// 18 años en el mercado (dato de José, 01/11/2026): nace en 2008.
// POR CONFIRMAR: los años de los hitos intermedios; por eso se nombran sin fecha.
const linea = [
  { marca: '2008', t: 'Nace SIG', d: 'Ventas, almacén, compras y contabilidad de la empresa en un solo sistema, hecho en Lima para la empresa peruana.' },
  { marca: 'La nube', t: 'Pioneros en la nube', d: 'Llevamos el ERP a la nube cuando casi todo se instalaba en un servidor de la oficina.' },
  { marca: 'SUNAT', t: 'Facturación electrónica', d: 'SIG emite los comprobantes electrónicos y genera los libros electrónicos (PLE) que pide SUNAT, desde el mismo sistema.' },
  { marca: '2026', t: 'SIG Advanced', d: '100% web, con Notificaciones SUNAT y Consultas con IA. La experiencia de siempre, con la tecnología de hoy.' },
];
const pilares = [
  { t: 'Una casa de software', d: 'SIG no es un enlatado. Además del ERP, desarrollamos a medida lo que tu empresa necesita y lo integramos al sistema.' },
  { t: 'A la vanguardia', d: 'Innovamos para que nuestros clientes trabajen con herramientas modernas: web, nube, integración con SUNAT e inteligencia artificial.' },
  { t: 'Un equipo preparado', d: 'Profesionales con experiencia en sistemas y en gestión de empresas, alineados con una misma visión: que a tu negocio no le falte información a tiempo.' },
];
---

<section id="nosotros" class:list={['chapter', tono(tone)]} data-ink aria-labelledby="nosotros-title">
  <div class="wrap about">
    <div class="about-intro">
      <h2 id="nosotros-title" class="headline about-title" data-reveal>18 años en el mercado. <span class="it it-accent">Nada improvisado.</span></h2>
      <p class="lead about-lead" data-reveal>
        SIG nació en 2008 en <span class="whitespace-nowrap">{empresa.nombre}</span> para ordenar la gestión de la pequeña y mediana empresa peruana.
        Desde entonces no ha dejado de crecer: cada cambio en las normas de SUNAT, cada nueva tecnología y cada pedido de un cliente
        se volvió parte del sistema.
      </p>
    </div>

    <ol class="timeline" data-reveal>
      {linea.map((h) => (
        <li>
          <span class="tl-mark it">{h.marca}</span>
          <span class="tl-dot" aria-hidden="true"></span>
          <b>{h.t}</b>
          <p>{h.d}</p>
        </li>
      ))}
    </ol>

    <div class="about-grid">
      <figure class="postventa" data-reveal>
        <blockquote>
          <p class="it">«Nuestro punto más fuerte es lo que pasa después de la venta.»</p>
        </blockquote>
        <figcaption>
          Soporte postventa cercano, de gente que conoce tu negocio y responde cuando hace falta. En eso basan su
          confianza nuestros clientes.
        </figcaption>
        <a class="btn" href={wa(mensajes.general)} target="_blank" rel="noopener">Conversemos por WhatsApp</a>
      </figure>

      <ul class="pilares">
        {pilares.map((p) => (
          <li data-reveal><b>{p.t}</b><p>{p.d}</p></li>
        ))}
        <li data-reveal class="pilar-link"><a href="/desarrollos">Conoce nuestras integraciones, agentes de IA y desarrollos a medida <span aria-hidden="true">→</span></a></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .about { padding-block: 7.5rem 6rem; }
  .about-intro { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 2rem 4rem; align-items: end; }
  .about-title { max-width: 13ch; }
  .about-lead { max-width: 34rem; }

  .timeline {
    margin-top: 4.5rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 4.35rem;
    height: 1px; /* taste-skill-ignore: eje de la línea de tiempo */
    background: var(--line);
  }
  .timeline li { position: relative; display: flex; flex-direction: column; }
  .tl-mark { font-size: clamp(2.5rem, 4vw, 3.75rem); color: var(--head); line-height: 1; height: 3.6rem; display: flex; align-items: flex-end; white-space: nowrap; }
  .tl-dot { width: 0.8rem; height: 0.8rem; border-radius: 50%; background: var(--c-accent); margin: 0.85rem 0 1.25rem; box-shadow: 0 0 0 6px var(--bg); /* taste-skill-ignore: hito sobre el eje */ }
  .timeline b { font-size: 1.125rem; color: var(--head); }
  .timeline p { margin-top: 0.35rem; font-size: 1rem; color: var(--fg-2); max-width: 28ch; }

  .about-grid { margin-top: 4.5rem; display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 2rem 4rem; align-items: start; }
  .postventa {
    background: var(--chip);
    border-radius: 24px;
    padding: clamp(1.75rem, 3vw, 2.75rem);
  }
  .postventa blockquote p { font-size: clamp(1.9rem, 3vw, 2.75rem); line-height: 1.08; color: var(--head); }
  .postventa figcaption { margin: 1.25rem 0 1.75rem; font-size: 1.0625rem; color: var(--fg-2); max-width: 40ch; }
  .pilares { display: grid; gap: 1.75rem; }
  .pilares li { padding-left: 1.25rem; position: relative; }
  .pilares li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--c-accent); }
  .pilares b { font-size: 1.25rem; color: var(--head); }
  .pilar-link::before { display: none; }
  .pilar-link a { font-weight: 700; color: var(--head); text-decoration: underline; text-decoration-color: var(--c-accent); text-underline-offset: 5px; text-decoration-thickness: 2px; }
  .pilares p { margin-top: 0.3rem; font-size: 1.0625rem; color: var(--fg-2); }

  @media (max-width: 1023px) {
    .about { padding-block: 6rem 4rem; }
    .about-intro, .about-grid { grid-template-columns: 1fr; }
    .timeline { grid-template-columns: 1fr 1fr; row-gap: 2.5rem; }
    .timeline::before { display: none; }
  }
  @media (max-width: 599px) {
    .timeline { grid-template-columns: 1fr; gap: 0; margin-top: 3rem; padding-left: 1.5rem; border-left: 1px solid var(--line); /* taste-skill-ignore: eje de la línea de tiempo */ }
    .timeline li { padding-bottom: 2rem; }
    .tl-mark { height: auto; font-size: 2.25rem; }
    .tl-dot { position: absolute; left: calc(-1.5rem - 0.4rem); top: 0.9rem; margin: 0; }
    .timeline b { margin-top: 0.5rem; }
  }
</style>
