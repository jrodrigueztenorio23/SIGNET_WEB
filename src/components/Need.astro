---
import { ejemplosNecesidad, modulos, wa } from '../config/site';

const inicial = modulos[0];
const datos = modulos.map(({ id, nombre, opciones, resumen, pantallas, claves }) => ({ id, nombre, opciones, resumen, pantallas, claves }));
---

<section id="necesidad" class="chapter bg-indigo text-paper" data-ink="#ffffff" aria-labelledby="necesidad-title">
  <div class="wrap flex min-h-[90svh] flex-col pt-28 pb-14 md:pt-36">
    <h2 id="necesidad-title" class="title max-w-[24ch]" data-reveal>¿Qué necesita resolver tu empresa?</h2>

    <label class="sr-only" for="need-input">Escribe lo que necesitas resolver</label>
    <div class="need-line mt-6" data-ui data-reveal>
      <input
        id="need-input"
        class="need-input headline"
        type="text"
        value={ejemplosNecesidad[0]}
        autocomplete="off"
        spellcheck="false"
      />
    </div>

    <div class="mt-12 grid gap-10 md:grid-cols-12">
      <div class="answer md:col-span-6 lg:col-span-5" data-ui aria-live="polite" data-reveal>
        <p class="answer-name title" id="need-name">Módulo {inicial.nombre}</p>
        <p class="answer-summary" id="need-summary">{inicial.resumen}</p>
        <ul class="answer-rows" id="need-rows">
          {inicial.pantallas.map((p) => <li>{p}</li>)}
        </ul>
        <a id="need-cta" class="answer-cta" target="_blank" rel="noopener"
          href={wa(`Hola, quiero saber más del módulo ${inicial.nombre} de SIG Advanced.`)}>
          Consultar por {inicial.nombre}
          <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 9h13M10 4l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.4"/></svg>
        </a>
        <button type="button" id="need-see" class="answer-see link-underline" data-module={inicial.id}>Ver la pantalla</button>
      </div>

      <div class="md:col-span-5 md:col-start-8 lg:col-start-8 self-end" data-reveal>
        <p class="small mb-3 font-semibold">Prueba con otro</p>
        <ul class="flex flex-wrap gap-2">
          {ejemplosNecesidad.slice(1).map((e) => (
            <li><button type="button" class="example" data-example={e}>{e}</button></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<script type="application/json" id="need-data" set:html={JSON.stringify(datos)}></script>

<style>
  .need-line { position: relative; }
  .need-input {
    width: 100%;
    background: transparent;
    border: 0;
    color: var(--color-paper);
    caret-color: var(--color-orange);
    caret-shape: block;
    padding: 0;
    text-overflow: ellipsis;
  }
  .need-input:focus { outline: none; }
  .need-line:focus-within { outline: 3px solid var(--color-orange); outline-offset: 8px; }

  .answer {
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 1.5rem;
    max-width: 35rem;
  }
  .answer-name { color: var(--color-navy); }
  .answer-summary { margin-top: 0.5rem; }
  .answer-rows { margin-top: 1rem; }
  .answer-rows li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    font-size: 1rem;
  }
  .answer-rows li:nth-child(odd) { background: var(--color-mist); }
  .answer-rows li::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-orange);
    flex: none;
  }
  .answer-cta {
    margin-top: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    background: var(--color-navy);
    color: var(--color-paper);
    font-weight: 700;
    transition: background-color 200ms ease, transform 160ms var(--ease-out-quint);
  }
  .answer-cta:hover { background: var(--color-navy-deep); }
  .answer-see { margin-left: 1.25rem; font-weight: 700; color: var(--color-indigo); min-height: 2.75rem; }
  .answer-see[hidden] { display: none; }
  .answer-cta:active { transform: scale(0.97); }

  .example {
    min-height: 2.75rem;
    padding: 0 1rem;
    background: var(--color-indigo-up);
    color: var(--color-paper);
    font-size: 1rem;
    font-weight: 600;
    text-align: left;
    transition: background-color 200ms ease, transform 160ms var(--ease-out-quint);
  }
  .example:hover { background: var(--color-navy); }
  .example:active { transform: scale(0.97); }

  @media (max-width: 767px) {
    .need-input { font-size: 11vw; }
  }
</style>

<script>
  import { wa } from '../config/site';

  type Mod = { id: string; nombre: string; resumen: string; pantallas: string[]; claves: string[] };
  const data: Mod[] = JSON.parse(document.getElementById('need-data')!.textContent || '[]');
  const input = document.getElementById('need-input') as HTMLInputElement;
  const nameEl = document.getElementById('need-name')!;
  const summaryEl = document.getElementById('need-summary')!;
  const rowsEl = document.getElementById('need-rows')!;
  const cta = document.getElementById('need-cta') as HTMLAnchorElement;
  const see = document.getElementById('need-see') as HTMLButtonElement;
  const conPantalla = new Set(['comercial', 'almacen', 'compras', 'bancos', 'contabilidad', 'planillas', 'produccion', 'activos', 'crm']);
  see.addEventListener('click', () => {
    // En escritorio el recorrido fijado lleva el scroll al módulo; en pantallas chicas bajamos a la sección.
    if (innerWidth < 1024 || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.getElementById('pantallas')?.scrollIntoView();
    }
    document.dispatchEvent(new CustomEvent('tour:module', { detail: see.dataset.module }));
  });

  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

  function buscar(texto: string): Mod | null {
    const t = norm(texto);
    let mejor: Mod | null = null;
    let puntos = 0;
    for (const m of data) {
      const p = m.claves.reduce((s, c) => (t.includes(norm(c)) ? s + c.length : s), 0);
      if (p > puntos) { puntos = p; mejor = m; }
    }
    return mejor;
  }

  function pintar() {
    const texto = input.value.trim();
    const m = buscar(texto);
    if (m) {
      nameEl.textContent = `Módulo ${m.nombre}`;
      summaryEl.textContent = m.resumen;
      rowsEl.innerHTML = m.pantallas.map((p) => `<li>${p}</li>`).join('');
      cta.href = wa(`Hola, necesito ${texto} y quiero saber más del módulo ${m.nombre} de SIG Advanced.`);
      cta.firstChild!.textContent = `Consultar por ${m.nombre} `;
      see.dataset.module = m.id;
      see.hidden = !conPantalla.has(m.id);
    } else {
      nameEl.textContent = 'Te lo decimos por WhatsApp';
      summaryEl.textContent = texto
        ? 'No encontramos un módulo con esas palabras. Cuéntanos qué necesitas y te respondemos con la solución.'
        : 'Escribe arriba lo que necesitas: facturar, controlar el stock, pagar la planilla…';
      rowsEl.innerHTML = '';
      cta.href = wa(texto ? `Hola, necesito ${texto}. ¿SIG Advanced lo resuelve?` : 'Hola, tengo una consulta sobre SIG Advanced.');
      cta.firstChild!.textContent = 'Escríbenos ';
      see.hidden = true;
    }
  }

  input.addEventListener('input', pintar);
  document.querySelectorAll<HTMLButtonElement>('[data-example]').forEach((b) =>
    b.addEventListener('click', () => {
      input.value = b.dataset.example || '';
      pintar();
      input.focus({ preventScroll: true });
    }),
  );
  pintar();
</script>
