---
import { empresa, mensajes, wa } from '../config/site';
import { pantallas } from '../config/screens';
import { tono, type Tono } from '../config/modelos';
import SigScreen from './SigScreen.astro';

interface Props { tone: Tono }
const { tone } = Astro.props;

// Los arcos naranjas del logo de SIG, redibujados: tres anillos partidos que giran con el scroll.
const anillos = [
  { r: 230, w: 30, dash: '420 90 260 120 300 140' },
  { r: 178, w: 22, dash: '300 70 180 110 240 90' },
  { r: 132, w: 16, dash: '160 60 220 80 110 50' },
];
const comercial = pantallas.find((p) => p.id === 'comercial')!;
const ventas = [38, 52, 47, 61, 58, 72, 69, 84];
const hechos = [
  { n: '18', t: 'años en el mercado' },
  { n: '12', t: 'módulos conectados' },
  { n: '100%', t: 'web, en la nube' },
];
---

<section id="inicio" class:list={['chapter hero', tono(tone)]} data-ink aria-labelledby="hero-title">
  <div class="rings" aria-hidden="true">
    <svg viewBox="-260 -260 520 520" width="520" height="520">
      {anillos.map((a, i) => (
        <circle class={`ring ring-${i}`} r={a.r} fill="none" stroke="currentColor" stroke-width={a.w} stroke-dasharray={a.dash} />
      ))}
    </svg>
  </div>

  <div class="wrap hero-copy relative z-10">
    <h1 id="hero-title" class="headline hero-title">
      <span class="line block overflow-hidden"><span class="line-inner block">18 años ordenando</span></span>
      <span class="line block overflow-hidden"><span class="line-inner block">empresas peruanas.</span></span>
      <span class="line block overflow-hidden"><span class="line-inner block"><span class="it it-accent">Ahora en la nube</span></span></span>
      <span class="line block overflow-hidden"><span class="line-inner block"><span class="it it-accent">y con IA.</span></span></span>
    </h1>
    <p class="hero-lead lead" data-reveal>
      <strong>{empresa.producto}</strong> es el ERP web de <span class="whitespace-nowrap">{empresa.nombre}</span>: ventas con facturación electrónica,
      almacén, compras, bancos, producción, contabilidad y planillas en un solo sistema, con un equipo que te acompaña
      después de la venta.
    </p>
    <div class="hero-actions" data-reveal>
      <a class="btn" data-magnetic href={wa(mensajes.demo)} target="_blank" rel="noopener">
        Solicita una demo por WhatsApp
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 9h13M10 4l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.4"/></svg>
      </a>
      <a href="#pantallas" class="link-underline font-semibold">Ver el sistema por dentro</a>
    </div>
    <ul class="hero-facts" data-reveal>
      {hechos.map((h) => <li><b class="tabular" data-count={/^\d+$/.test(h.n) ? h.n : undefined}>{h.n}</b><span>{h.t}</span></li>)}
    </ul>
  </div>

  <div class="stage">
    <div class="stage-inner" data-depth="0.4">
      <SigScreen p={comercial} class="hero-screen" lazy={false} />
    </div>

    <div class="float f-sunat" data-depth="1.4" data-ui aria-hidden="true">
      <span class="f-dot"></span>
      <span><b>F001-00004812</b><small>Aceptada por SUNAT · hace 2 s</small></span>
    </div>

    <div class="float f-sales" data-depth="1" data-ui aria-hidden="true">
      <small>Ventas de octubre</small>
      <b class="tabular">S/ 248,310</b>
      <span class="f-bars">{ventas.map((v, i) => <i style={`--v:${v}%`} class:list={{ hi: i === ventas.length - 1 }}></i>)}</span>
    </div>

    <div class="float f-stock" data-depth="1.8" data-ui aria-hidden="true">
      <small>Stock bajo</small>
      <b>Ladrillo King Kong</b>
      <span class="tabular">24 millares · pedir hoy</span>
    </div>
  </div>
</section>

<style>
  .hero { min-height: 100svh; }
  .hero-copy { padding-top: 15svh; max-width: 44rem; }
  .hero-title { font-size: clamp(2.6rem, 4.6vw, 4.75rem); line-height: 1.02; }
  .hero-title .it { line-height: 1.05; }
  .hero-lead { margin-top: 1.75rem; max-width: 34rem; }
  .hero-lead strong { color: var(--fg); font-weight: 700; }
  .hero-actions { margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; }
  .hero-facts { margin-top: 3rem; display: flex; flex-wrap: wrap; gap: 1.25rem 2.5rem; }
  .hero-facts li { display: flex; flex-direction: column; padding-left: 1rem; border-left: 2px solid var(--c-accent); }
  .hero-facts b { font-size: 2rem; font-weight: 760; line-height: 1; letter-spacing: -0.02em; color: var(--head); }
  .hero-facts span { font-size: 0.9375rem; color: var(--fg-2); margin-top: 0.3rem; }

  .stage {
    position: absolute;
    left: 50vw;
    top: 20svh;
    width: 60vw;
    perspective: 1800px;
    pointer-events: none;
  }
  .stage-inner {
    transform-style: preserve-3d;
    transform: rotateY(-16deg) rotateX(7deg) rotateZ(1.5deg);
    transform-origin: 0% 50%;
  }
  .hero-screen { border-radius: 12px; overflow: hidden; outline: 1px solid var(--line); }
  :global(.hero-screen .sig) { box-shadow: var(--shadow); /* taste-skill-ignore: pantalla flotante */ }

  .float {
    position: absolute;
    background: #fff;
    color: #1a2332;
    border-radius: 14px;
    padding: 14px 18px;
    font-family: Roboto, 'Segoe UI', system-ui, sans-serif; /* taste-skill-ignore: tipografía de SIG */
    box-shadow: 0 24px 48px -18px rgb(11 42 91 / 0.35); /* taste-skill-ignore: tarjeta flotante */
    display: flex;
    gap: 12px;
  }
  .float small { display: block; font-size: 13px; color: #4a5568; }
  .float b { display: block; font-size: 17px; }
  .f-sunat { top: -4%; left: -6%; align-items: center; }
  .f-dot { width: 12px; height: 12px; border-radius: 50%; background: #16a34a; box-shadow: 0 0 0 5px #dcf3e5; flex: none; /* taste-skill-ignore: estilo de SIG */ }
  .f-sales { bottom: 4%; left: -10%; flex-direction: column; gap: 2px; width: 230px; }
  .f-sales b { font-size: 26px; color: #004080; letter-spacing: -0.01em; }
  .f-bars { display: flex; align-items: flex-end; gap: 5px; height: 46px; margin-top: 8px; }
  .f-bars i { flex: 1; height: var(--v); background: #d3e2f4; border-radius: 2px; }
  .f-bars i.hi { background: var(--c-accent); }
  .f-stock { top: 30%; right: 30%; flex-direction: column; gap: 2px; border-left: 4px solid var(--c-accent); }
  .f-stock span { font-size: 14px; color: #9a5b00; font-weight: 600; }

  .rings {
    position: absolute;
    right: -10vw;
    top: -16vw;
    width: min(44vw, 640px);
    aspect-ratio: 1;
    pointer-events: none;
    color: var(--c-accent);
    opacity: 0.55;
  }
  .tone-dark .rings { opacity: 0.8; }
  .rings svg { width: 100%; height: 100%; overflow: visible; }

  @media (max-width: 1023px) {
    .hero { display: flex; flex-direction: column; padding-bottom: 3rem; }
    .hero-copy { padding-top: 7.5rem; }
    .stage { position: relative; left: auto; top: auto; width: 112%; margin: 3rem 0 0 var(--margin); }
    .stage-inner { transform: rotateY(-10deg) rotateX(5deg); }
    .f-sunat { top: -18%; left: 2%; }
    .f-sales { left: auto; right: 14%; bottom: -16%; width: 200px; }
    .f-stock { display: none; }
    .rings { width: 70vw; right: -34vw; top: 3rem; opacity: 0.22; }
    .tone-dark .rings { opacity: 0.35; }
  }
  @media (max-width: 599px) {
    .hero-title { font-size: 2.35rem; }
    .hero-facts { gap: 1rem 1.5rem; }
    .hero-facts b { font-size: 1.6rem; }
    .float { padding: 10px 12px; }
    .float b { font-size: 14px; }
    .float small { font-size: 12px; }
    .f-sales { width: 160px; }
    .f-sales b { font-size: 19px; }
    .f-bars { height: 30px; }
    /* En celular la pantalla entra completa, con un giro leve. */
    .stage { width: auto; margin: 3.5rem var(--margin) 2rem; }
    .stage-inner { transform: rotateY(-6deg) rotateX(3deg); transform-origin: 50% 50%; }
    .f-sunat { top: -22%; left: -2%; }
    .f-sales { right: -2%; bottom: -22%; }
  }
</style>
