---
import { mensajes, wa } from '../config/site';

const incluye = [
  'Los 12 módulos',
  'Facturación electrónica SUNAT',
  'Acceso web desde cualquier lugar',
  'Soporte postventa',
];
---

<section id="plan" class="chapter bg-navy text-paper flex flex-col justify-center" data-ink="#ffffff" aria-labelledby="plan-title">
  <div class="wrap py-28">
    <h2 class="title mb-10 max-w-[20ch]" data-reveal>Un plan, armado para tu empresa</h2>
    <article class="ticket" data-reveal>
      <div class="ticket-main">
        <h3 id="plan-title" class="ticket-title">Plan SIG Advanced</h3>
        <ul class="ticket-list">
          {incluye.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <div class="ticket-stub">
        <p class="ticket-price">A tu medida</p>
        <p class="small">Según módulos y usuarios</p>
        <a class="ticket-cta" href={wa(mensajes.plan)} target="_blank" rel="noopener">Solicitar cotización</a>
      </div>
      <span class="perf" aria-hidden="true">{Array.from({ length: 14 }, () => <i></i>)}</span>
      <span class="notch notch-a" aria-hidden="true"></span>
      <span class="notch notch-b" aria-hidden="true"></span>
    </article>
  </div>
</section>

<style>
  .ticket {
    position: relative;
    display: grid;
    grid-template-columns: 7fr 3fr;
    width: min(64vw, 100%);
    min-width: min(100%, 52rem);
    margin-inline: auto;
    aspect-ratio: 2.3 / 1;
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .ticket-main { padding: 40px; display: flex; flex-direction: column; justify-content: space-between; gap: 2rem; }
  .ticket-title {
    font-size: clamp(2.25rem, 4vw, 4rem);
    font-weight: 820;
    letter-spacing: -0.03em;
    line-height: 0.95;
    color: var(--color-navy);
  }
  .ticket-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 2rem;
    font-size: 1.0625rem;
    font-weight: 600;
  }
  .ticket-list li { display: flex; gap: 0.6rem; align-items: baseline; }
  .ticket-list li::before { content: ''; width: 0.55rem; height: 0.55rem; background: var(--color-orange); flex: none; }
  .ticket-stub {
    position: relative;
    padding: 40px 28px 28px;
    background: var(--color-mist);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.4rem;
  }
  .ticket-price {
    font-size: clamp(2rem, 3.6vw, 3.5rem);
    font-weight: 840;
    letter-spacing: -0.035em;
    line-height: 1;
    margin-top: auto;
  }
  .ticket-cta {
    margin-top: auto;
    width: 100%;
    min-height: 56px;
    display: grid;
    place-items: center;
    background: var(--color-orange);
    color: var(--color-ink);
    font-weight: 750;
    transition: background-color 200ms ease, transform 160ms var(--ease-out-quint);
  }
  .ticket-cta:hover { background: #ffb23a; }
  .ticket-cta:active { transform: scale(0.97); }
  .perf {
    position: absolute;
    left: 70%;
    top: 22px;
    bottom: 22px;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .perf i { display: block; width: 6px; height: 6px; border-radius: 50%; background: var(--color-navy); }
  .notch {
    position: absolute;
    left: 70%;
    width: 28px;
    height: 28px;
    margin-left: -14px;
    border-radius: 50%;
    background: var(--color-navy);
  }
  .notch-a { top: -14px; }
  .notch-b { bottom: -14px; }

  @media (max-width: 767px) {
    .ticket { grid-template-columns: 1fr; aspect-ratio: auto; min-width: 0; width: 100%; }
    .ticket-main { padding: 28px 24px; }
    .ticket-title { font-size: 9vw; }
    .ticket-list { grid-template-columns: 1fr; }
    .ticket-stub {
      padding: 32px 24px 24px;
      gap: 0.5rem;
    }
    .ticket-price { font-size: 13vw; }
    .ticket-cta { margin-top: 1rem; }
    .perf, .notch { display: none; }
  }
</style>
