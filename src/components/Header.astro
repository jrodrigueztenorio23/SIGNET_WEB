---
import { empresa, mensajes, wa } from '../config/site';

const enlaces = [
  { href: '#modulos', texto: 'Módulos' },
  { href: '#clientes', texto: 'Clientes' },
  { href: '#plan', texto: 'Plan' },
  { href: '#nosotros', texto: 'Nosotros' },
];
---

<header id="header" class="wrap fixed inset-x-0 top-0 z-50 flex h-18 items-center justify-between gap-6">
  <a href="#inicio" class="flex items-center gap-3 font-bold tracking-tight" aria-label={`${empresa.producto}, ir al inicio`}>
    <img src="/logo-sig.png" alt="" width="44" height="34" class="h-8.5 w-auto" />
    <span class="text-[1.0625rem]">{empresa.producto}</span>
  </a>
  <nav aria-label="Principal" class="hidden md:block">
    <ul class="flex gap-8 text-[1rem] font-medium">
      {enlaces.map((e) => <li><a class="link-underline" href={e.href}>{e.texto}</a></li>)}
    </ul>
  </nav>
  <a class="btn btn-header" href={wa(mensajes.demo)} target="_blank" rel="noopener">
    <span class="hidden sm:inline">Solicita una demo</span>
    <span class="sm:hidden">Demo</span>
  </a>
</header>

<style>
  #header {
    color: var(--header-ink);
    background: var(--header-bg, transparent);
    transition: color 300ms ease, background-color 300ms ease;
  }
  .btn-header {
    min-height: 2.75rem;
    padding: 0 1.125rem;
    font-size: 0.9375rem;
  }
</style>
