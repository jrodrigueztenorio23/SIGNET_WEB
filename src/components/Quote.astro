---
import { modulos, wa } from '../config/site';

const preseleccion = new Set(['comercial', 'almacen', 'contabilidad']);
---

<section id="cotizar" class="chapter bg-indigo text-paper" data-ink="#ffffff" aria-labelledby="cotizar-title">
  <div class="wrap grid min-h-[90svh] gap-12 py-28 md:grid-cols-12 md:items-end">
    <div class="md:col-span-5 md:pb-10">
      <h2 id="cotizar-title" class="headline-cta" data-reveal>Arma tu SIG</h2>
      <p class="mt-6 max-w-[36ch]" data-reveal>
        Elige los módulos que necesitas y envíanos tu pedido por WhatsApp. Te respondemos con la cotización y
        una fecha para la demo.
      </p>
    </div>

    <form id="quote" class="dialog md:col-span-6 md:col-start-7 md:self-center" data-ui data-reveal novalidate>
      <p class="dialog-title">Nueva cotización</p>

      <label class="field">
        <span>Empresa</span>
        <input name="empresa" type="text" value="Distribuidora Los Andes SAC" autocomplete="organization" />
      </label>

      <fieldset class="field">
        <legend>Usuarios</legend>
        <div class="segmented">
          <label><input type="radio" name="usuarios" value="hasta 10 usuarios" checked /><span>Hasta 10</span></label>
          <label><input type="radio" name="usuarios" value="más de 10 usuarios" /><span>Más de 10</span></label>
        </div>
      </fieldset>

      <fieldset class="field">
        <legend>Módulos <span id="quote-count" class="tabular">(3)</span></legend>
        <div class="chips">
          {modulos.map((m) => (
            <label class="chip">
              <input type="checkbox" name="modulos" value={m.nombre} checked={preseleccion.has(m.id)} />
              <span>{m.nombre}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <a id="quote-send" class="dialog-cta" target="_blank" rel="noopener" href={wa('Hola, quiero una cotización de SIG Advanced.')}>
        Enviar por WhatsApp
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 9h13M10 4l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.4"/></svg>
      </a>
    </form>
  </div>
</section>

<style>
  .headline-cta {
    font-size: clamp(3.5rem, 7vw, 7rem);
    font-weight: 840;
    line-height: 0.92;
    letter-spacing: -0.035em;
  }
  .dialog {
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 28px;
    width: 100%;
    max-width: 34rem;
    justify-self: end;
    box-shadow: 0 24px 60px -20px rgb(0 31 64 / 0.45); /* taste-skill-ignore: diálogo abierto */
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .dialog-title { font-size: 1.375rem; font-weight: 760; }
  .field { display: flex; flex-direction: column; gap: 0.4rem; border: 0; padding: 0; margin: 0; }
  .field > span, .field legend { font-size: var(--text-small); font-weight: 650; color: #4a4f6a; padding: 0; margin-bottom: 0.4rem; }
  .field input[type='text'] {
    min-height: 3rem;
    padding: 0 0.875rem;
    font-size: 1.0625rem;
    background: var(--color-mist);
    border: 2px solid transparent;
    transition: border-color 160ms ease;
  }
  .field input[type='text']:focus { outline: none; border-color: var(--color-navy); }

  .segmented { display: grid; grid-template-columns: 1fr 1fr; background: var(--color-mist); padding: 4px; }
  .segmented label { position: relative; }
  .segmented input, .chip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .segmented span {
    display: grid; place-items: center; min-height: 2.75rem; font-weight: 650;
    transition: background-color 180ms ease, color 180ms ease;
  }
  .segmented input:checked + span { background: var(--color-navy); color: var(--color-paper); }
  .segmented input:focus-visible + span, .chip input:focus-visible + span { outline: 3px solid var(--color-orange); outline-offset: 2px; }

  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { position: relative; }
  .chip span {
    display: inline-flex; align-items: center; min-height: 2.5rem; padding: 0 0.875rem;
    background: var(--color-mist); font-size: 0.9375rem; font-weight: 600;
    transition: background-color 180ms ease, color 180ms ease, transform 160ms var(--ease-out-quint);
  }
  .chip:hover span { background: var(--color-mist-down); }
  .chip input:checked + span { background: var(--color-ink); color: var(--color-paper); }
  .chip:active span { transform: scale(0.96); }

  .dialog-cta {
    display: flex; align-items: center; justify-content: center; gap: 0.75rem;
    min-height: 3.5rem; background: #1f9d55; color: #fff; font-weight: 750; font-size: 1.0625rem;
    transition: background-color 200ms ease, transform 160ms var(--ease-out-quint);
  }
  .dialog-cta:hover { background: #188a49; }
  .dialog-cta:active { transform: scale(0.98); }

  @media (max-width: 767px) {
    .headline-cta { font-size: 15vw; }
    .dialog { padding: 20px; justify-self: stretch; }
    .dialog-cta { min-height: 3.25rem; }
  }
</style>

<script>
  import { wa } from '../config/site';

  const form = document.getElementById('quote') as HTMLFormElement;
  const send = document.getElementById('quote-send') as HTMLAnchorElement;
  const count = document.getElementById('quote-count')!;

  function actualizar() {
    const datos = new FormData(form);
    const empresa = String(datos.get('empresa') || '').trim();
    const usuarios = String(datos.get('usuarios') || '');
    const mods = datos.getAll('modulos').map(String);
    count.textContent = `(${mods.length})`;
    const lineas = [
      'Hola, quiero una cotización de SIG Advanced.',
      empresa && `Empresa: ${empresa}`,
      usuarios && `Usuarios: ${usuarios}`,
      mods.length ? `Módulos: ${mods.join(', ')}` : 'Módulos: aún no lo sé, quiero asesoría',
    ].filter(Boolean);
    send.href = wa(lineas.join('\n'));
  }

  form.addEventListener('input', actualizar);
  form.addEventListener('change', actualizar);
  form.addEventListener('submit', (e) => e.preventDefault());
  actualizar();
</script>
