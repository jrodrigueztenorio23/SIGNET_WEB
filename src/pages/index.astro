---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ModulosVista from '../components/ModulosVista.astro';
import Capacidades from '../components/Capacidades.astro';
import Flujo from '../components/Flujo.astro';
import Tour from '../components/Tour.astro';
import Sunat from '../components/Sunat.astro';
import Ia from '../components/Ia.astro';
import Modules from '../components/Modules.astro';
import About from '../components/About.astro';
import Clients from '../components/Clients.astro';
import Footer from '../components/Footer.astro';
import { tonos as t } from '../config/modelos';
---

<Base>
  <a href="#cifras" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[70] focus:bg-paper focus:p-3">Saltar al contenido</a>
  <Header />
  <main>
    <Hero tone={t.hero} />
    <ModulosVista tone={t.cifras} />
    <Capacidades tone={t.capacidades} />
    <Flujo tone={t.flujo} />
    <Tour tone={t.pantallas} />
    <Sunat tone={t.sunat} />
    <Ia tone={t.ia} />
    <Modules tone={t.modulos} />
    <About tone={t.nosotros} />
    <Clients tone={t.clientes} />
  </main>
  <Footer tone={t.footer} />
</Base>

<script>
  import '../scripts/motion';
</script>
