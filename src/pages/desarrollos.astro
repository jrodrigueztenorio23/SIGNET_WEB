  @media (prefers-reduced-motion: reduce) {
    .orbit-ring, .orbit-spin, .sat, .orbit-mascot, .hub-halo, .packet, .node, .agent-dot, .proc-n, .cta-mascot { animation: none !important; }
  }
</style>

<script>
  import '../scripts/motion';
  import { wa } from '../config/site';

  // El agente trabaja en bucle: cada paso gira, se marca y al final entrega el Excel.
  const agente = document.querySelector<HTMLElement>('.agent');
  const pasosAg = [...document.querySelectorAll<HTMLElement>('.agent-steps li')];
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (agente && quieto) {
    pasosAg.forEach((p) => p.classList.add('is-done'));
    agente.classList.add('is-done');
  } else if (agente) {
    const espera = (ms: number) => new Promise((r) => setTimeout(r, ms));
    (async () => {
      for (;;) {
        pasosAg.forEach((p) => p.classList.remove('is-run', 'is-done'));
        agente.classList.remove('is-done');
        await espera(700);
        for (const p of pasosAg) {
          p.classList.add('is-run');
          await espera(1000);
          p.classList.replace('is-run', 'is-done');
          await espera(150);
        }
        agente.classList.add('is-done');
        await espera(3600);
      }
    })();
  }

  const send = document.getElementById('dv-send') as HTMLAnchorElement;
  document.querySelectorAll<HTMLInputElement>('input[name="tipo"]').forEach((r) =>
    r.addEventListener('change', () => { if (r.checked) send.href = wa(r.dataset.msg || ''); }),
  );
</script>
