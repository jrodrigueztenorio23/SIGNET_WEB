---
import '../styles/global.css';
import { empresa } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${empresa.producto} · ERP web para empresas peruanas | ${empresa.nombre}`,
  description = 'SIG Advanced es el ERP web de Lite Software & Consulting SAC: comercial con facturación electrónica SUNAT, almacén, compras, bancos, producción, contabilidad, planillas y CRM en un solo sistema.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#13294a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <link rel="icon" type="image/png" href="/logo-sig.png" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />
  </body>
</html>
